# Generated by build.rs from packaging/homebrew/formula.rb.in. Do not edit by hand.
class {{class}} < Formula
  desc "{{description}}"
  homepage "{{homepage}}"
  license "{{license}}"

  on_macos do
    on_arm do
      url "{{homepage}}/releases/download/v{{version}}/{{name}}-aarch64-apple-darwin.tar.xz"
      sha256 "{{sha256_aarch64_apple_darwin}}"
    end
    on_intel do
      url "{{homepage}}/releases/download/v{{version}}/{{name}}-x86_64-apple-darwin.tar.xz"
      sha256 "{{sha256_x86_64_apple_darwin}}"
    end
  end

  on_linux do
    on_arm do
      url "{{homepage}}/releases/download/v{{version}}/{{name}}-aarch64-unknown-linux-gnu.tar.xz"
      sha256 "{{sha256_aarch64_unknown_linux_gnu}}"
    end
    on_intel do
      url "{{homepage}}/releases/download/v{{version}}/{{name}}-x86_64-unknown-linux-gnu.tar.xz"
      sha256 "{{sha256_x86_64_unknown_linux_gnu}}"
    end
  end

  def install
    bin.install "bin/{{name}}"
    man1.install "share/man/man1/{{name}}.1"
    bash_completion.install "share/bash-completion/completions/{{name}}"
    zsh_completion.install "share/zsh/site-functions/_{{name}}"
    fish_completion.install "share/fish/vendor_completions.d/{{name}}.fish"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/{{name}} --version")
  end
end
